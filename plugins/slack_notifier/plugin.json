{
    "name": "slack_notifier",
    "description": "Sends an alert or notification message to the enterprise Slack channel.",
    "script": "python notify.py",
    "parameters": {
        "type": "object",
        "properties": {
            "channel": { "type": "string", "description": "Slack channel name (e.g. #network-ops)" },
            "message": { "type": "string", "description": "The message text to send" },
            "severity": { "type": "string", "enum": ["info", "warning", "critical"], "description": "Alert severity" }
        },
        "required": ["channel", "message", "severity"]
    }
}
